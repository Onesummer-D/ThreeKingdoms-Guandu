{
  "version": 1,
  "events": [
    {
      "id": "A01",
      "chapter": 1,
      "triggerNodeId": 100101,
      "text": "建安五年秋，袁绍兵临官渡，曹营隔河布垒，战云渐沉。"
    },
    {
      "id": "A02",
      "chapter": 1,
      "triggerNodeId": 100104,
      "text": "袁军高橹上箭如骤雨，曹军出入营垒，亦须持盾而行。"
    },
    {
      "id": "A03",
      "chapter": 1,
      "triggerNodeId": 100203,
      "text": "夜色未褪，曹军工兵营已灯火通明，锯木造车之声不绝。"
    },
    {
      "id": "A04",
      "chapter": 1,
      "triggerNodeId": 100206,
      "text": "发石车巨臂骤起，巨石击碎袁军高橹，木屑与尘埃俱落。"
    },
    {
      "id": "A05",
      "chapter": 1,
      "triggerNodeId": 100302,
      "text": "曹操命工兵避开正面箭雨，向袁营地下掘进。"
    },
    {
      "id": "A06",
      "chapter": 1,
      "triggerNodeId": 100306,
      "text": "袁军自堑壕中刺下长矛，地道塌陷，数十曹军工兵命丧地底。"
    },
    {
      "id": "A07",
      "chapter": 1,
      "triggerNodeId": 100503,
      "text": "袁军骑兵见曹军败退，抛开步军，争相沿狭道追击。"
    },
    {
      "id": "A08",
      "chapter": 1,
      "triggerNodeId": 100604,
      "text": "曹军后撤太远，袁军乘势逼近，原本设下的虚退竟成真溃。"
    },
    {
      "id": "B01",
      "chapter": 2,
      "triggerNodeId": 200001,
      "text": "相持日久，曹营存粮渐竭。营外旌旗未息，营内饥色已深。"
    },
    {
      "id": "B02",
      "chapter": 2,
      "triggerNodeId": 200005,
      "text": "荀彧的回信抵至中军帐，劝曹操扼守官渡，静待时局生变。"
    },
    {
      "id": "B03",
      "chapter": 2,
      "triggerNodeId": 200201,
      "text": "曹操听罢荀彧之谏，命全军固垒深沟，再守官渡。"
    },
    {
      "id": "B04",
      "chapter": 2,
      "triggerNodeId": 200310,
      "text": "撤军行列未稳，袁军骑兵已追至后阵，曹军渐次陷入混乱。"
    },
    {
      "id": "C01",
      "chapter": 3,
      "triggerNodeId": 300105,
      "text": "寒夜军帐外骤起争执，许攸叩营而至，曹操跣足相迎。"
    },
    {
      "id": "C02",
      "chapter": 3,
      "triggerNodeId": 300202,
      "text": "许攸问及军粮，曹操终以实情相告：仓中所余，已难久支。"
    },
    {
      "id": "C03",
      "chapter": 3,
      "triggerNodeId": 300301,
      "text": "面对许攸试探，曹操连称军粮尚足，未肯坦露困境。"
    },
    {
      "id": "C04",
      "chapter": 3,
      "triggerNodeId": 300309,
      "text": "许攸言明袁军粮秣屯于乌巢，曹操帐中骤添一条军情。"
    },
    {
      "id": "C05",
      "chapter": 3,
      "triggerNodeId": 300408,
      "text": "许攸被押出营帐，帐外一声闷响之后，再无其声。"
    },
    {
      "id": "D01",
      "chapter": 4,
      "triggerNodeId": 400101,
      "text": "官渡冬夜清寒，曹操凝视案上残旧舆图，众将待其定夺。"
    },
    {
      "id": "D02",
      "chapter": 4,
      "triggerNodeId": 400202,
      "text": "曹操决意亲赴乌巢，言此战存亡所系，不愿假手他将。"
    },
    {
      "id": "D03",
      "chapter": 4,
      "triggerNodeId": 400304,
      "text": "曹操坐镇官渡，未随奇袭之军离营，以稳住后方阵地。"
    },
    {
      "id": "E01",
      "chapter": 5,
      "triggerNodeId": 500101,
      "text": "曹军夜抵乌巢，第一把火燃起，火光惊动袁绍中军。"
    },
    {
      "id": "E02",
      "chapter": 5,
      "triggerNodeId": 500201,
      "text": "曹操拔出倚天剑，传令诸军：不予理会，专攻乌巢。"
    },
    {
      "id": "E03",
      "chapter": 5,
      "triggerNodeId": 500208,
      "text": "粮囤腹地攻破，曹军火把投向粮袋，连片火柱升上夜空。"
    },
    {
      "id": "E04",
      "chapter": 5,
      "triggerNodeId": 500214,
      "text": "清点战场时，曹军搜得许都官员与袁绍暗通的书信。"
    },
    {
      "id": "E05",
      "chapter": 5,
      "triggerNodeId": 500306,
      "text": "曹洪奉命点齐两千步骑，离开乌巢主阵，疾驰回援官渡。"
    },
    {
      "id": "E06",
      "chapter": 5,
      "triggerNodeId": 500310,
      "text": "乌巢守军退守粮囤，曹军攻势渐滞；官渡大营则勉强守住。"
    },
    {
      "id": "E07",
      "chapter": 5,
      "triggerNodeId": 500408,
      "text": "曹操剑指袁绍本阵，传令舍乌巢、弃官渡，转兵直击袁营。"
    },
    {
      "id": "E08",
      "chapter": 5,
      "triggerNodeId": 500415,
      "text": "奔袭途中，曹军饥疲交迫，马力不继，行军之势渐缓。"
    },
    {
      "id": "E09",
      "chapter": 5,
      "triggerNodeId": 500417,
      "text": "袁军铁骑层层迫近，曹操倚天剑坠地，亲卫接连倒下。"
    }
  ]
}
